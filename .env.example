# Push Observatory configuration
#
# Copy to `.env` and fill in. `.env` is gitignored at the repo root -- never
# commit real values. recap.py loads this file automatically.

# --- MiniMax API (recap.py) ------------------------------------------------
# Token Plan key from https://platform.minimax.io. Without this, recap.py still
# runs and delivers a statistical digest.
MINIMAX_API_KEY=
# Optional overrides. MiniMax serves the Anthropic Messages API at this URL.
# MINIMAX_BASE_URL=https://api.minimax.io/anthropic
# MINIMAX_MODEL=MiniMax-M2.7

# --- Delivery: ntfy.sh -----------------------------------------------------
# An ntfy topic is a PUBLIC URL. Anyone who guesses the name can read your
# recaps, so use something long and random, e.g.:
#     python3 -c "import secrets; print('pushobs-'+secrets.token_hex(8))"
# Then subscribe to that exact topic in the ntfy app on your phone.
PUSHOBS_NTFY_TOPIC=
PUSHOBS_NTFY_SERVER=https://ntfy.sh

# --- Delivery: email fallback (optional) -----------------------------------
# Used only if ntfy fails or is unset. For Gmail use an App Password, not
# your account password.
PUSHOBS_EMAIL_TO=
PUSHOBS_EMAIL_FROM=
PUSHOBS_SMTP_HOST=
PUSHOBS_SMTP_PORT=587
PUSHOBS_SMTP_USER=
PUSHOBS_SMTP_PASS=

# --- Misc ------------------------------------------------------------------
# Database location (default: ./alerts.db next to the scripts)
# PUSHOBS_DB=/Users/you/push-observatory/alerts.db

# Outlet package/name to spotlight in focus comparisons; leave blank to
# disable focus comparisons and show only aggregate views.
FOCUS_OUTLET=
